{
  "name": "gateway-backend",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "ts-node src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "typecheck": "tsc --noEmit",
    "dr:drill": "ts-node scripts/dr-drill.ts && ts-node scripts/dr-report.ts",
    "dr:report": "ts-node scripts/dr-report.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Payment collection, verification and settlement platform (sandbox-first)",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^12.5.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "helmet": "^8.3.0",
    "mailauth": "^4.13.3",
    "mailparser": "^3.9.38",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "5.9"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testRegex": "test/.*.spec.ts$",
    "testTimeout": 60000,
    "transform": {
      "^.+.ts$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151001
            ]
          }
        }
      ]
    }
  }
}
