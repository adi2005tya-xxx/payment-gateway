# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
# sandbox = simulated provider, simulated money. "live" is deliberately blocked until an approved adapter exists.
PAYMENT_MODE=sandbox
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
# Leave DATABASE_URL empty in development to use the embedded PGlite database in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
PROVIDER_WEBHOOK_SECRET=
# --- Provider (sandbox only) ---
# sandbox = gateway-style simulator; owner-account-sandbox = simulated owner bank account (customers pay OWNER_UPI_ID, payouts go to merchants' UPI IDs)
PROVIDER_KIND=sandbox
OWNER_UPI_ID=gateway-sandbox@sandboxbank
OWNER_OPENING_BALANCE_MINOR=0
UPI_PAYOUT_LIMIT_MINOR=10000000
# --- Notifications / alerts / web ---
WEB_BASE_URL=http://localhost:3000
# Browser origin allowed to call the API (CORS). Empty = none.
WEB_ORIGIN=http://localhost:3000
# e.g. smtps://user:pass@smtp.example.com:465 ; empty = notifications are only logged (kind + masked recipient)
SMTP_URL=
MAIL_FROM=Gateway <no-reply@localhost>
# Slack-compatible incoming webhook (or any JSON endpoint) for warning/critical alerts; optional HMAC secret
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# --- Bank-credit email confirmation (PROVIDER_KIND=bank-email; see docs/bank-email.md) ---
# PROVIDER_KIND=bank-email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. https://your-api/auth/google/callback (must match the OAuth client)
GOOGLE_REDIRECT_URI=
# sandbox/dev only: read saved .eml files from this folder instead of Gmail
MAIL_FOLDER_DIR=
MAIL_SYNC_INTERVAL_SECONDS=60
# reference_required (safest) or unique_amount_window (weaker; read the docs)
MATCH_POLICY=reference_required
ALERT_MAX_AGE_HOURS=48
ORDER_DEFAULT_EXPIRY_MINUTES=60
ORDER_GRACE_MINUTES=60
# Phone-notification evidence (unverified; see docs/phone-notifications.md). Paise.
# Credits above DEVICE_AUTO_CONFIRM_MAX_MINOR, or past DEVICE_DAILY_AUTO_LIMIT_MINOR in 24h, are held for a reviewer.
DEVICE_AUTO_CONFIRM_MAX_MINOR=50000
DEVICE_DAILY_AUTO_LIMIT_MINOR=500000
# a forwarded notification older than this (minutes) is rejected as a replay
DEVICE_MAX_AGE_MINUTES=10
# --- MFA / sessions ---
# base64 of exactly 32 random bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Inject from a secrets manager; never commit. To rotate: move the current value to _PREVIOUS and set a new current.
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_PREVIOUS=
MFA_ISSUER=Gateway
# Roles that must use MFA (must include ADMIN). Anyone who enrols is also held to MFA.
MFA_REQUIRED_ROLES=ADMIN
# How recent a factor check must be for high-risk operations (30-900)
MFA_STEPUP_WINDOW_SECONDS=300
# Mandatory wait between a second admin approving MFA recovery and the reset taking effect (>=1 in production)
MFA_RECOVERY_DELAY_HOURS=24
SESSION_TTL_MINUTES=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_MFA_PER_MIN=10
# First-run admin (optional; remove after first start)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Set false to run the API without the in-process job worker
WORKER_ENABLED=true
